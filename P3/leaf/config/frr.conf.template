! FRR global settings

frr defaults traditional
log syslog

! Zebra configuration
! Core daemon for FRR: routing tables, network interfaces.
! It also supervises different network routing protocols.

! BGPd (border gateway protocol daemon) configuration
! Propagates routing and reachability information between Autonomous Systems.
! It propagates to it's BGP neighbors.
! It informs it's neighbors about availables routes, best options, etc.

! active BGP on the leaf and associate it to AS number BGP_ASN
! define ID router
! define a neighbor of addresse $RR_LO_IP and which is in same AS
! specify that peering with this neighbor have to use loopback interface, which is more stable
! activate BGP also for EVPN routes
! activate peering bgp for EVPN route for the Session neighbor $RR_LO_IP (before that, the session with this neighbor does not allow EVPN routes)
! activate automatic publishing of all VNI of this leag


router bgp ${BGP_ASN}
  bgp router-id ${LO_IP}
  neighbor ${RR_LO_IP} remote-as ${BGP_ASN}
  neighbor ${RR_LO_IP} update-source lo
  address-family l2vpn evpn
    neighbor ${RR_LO_IP} activate
    advertise-all-vni

! OSPFd (Open shortest path first daemon) configuration
! It helps calculate the best path in one AS and build a map of the network.
! actiavte OSPF for all interface of the leaf

router ospf
  network 0.0.0.0/0 area 0

! ISISd (Intermediate system to intermediate system daemon) configuration
! It exchanges routing information between routers within an AS
